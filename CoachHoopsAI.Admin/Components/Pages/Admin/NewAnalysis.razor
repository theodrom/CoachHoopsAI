@page "/admin/analysis/new"
@using CoachHoopsAI.Admin.Models
@using CoachHoopsAI.Admin.Services

@inject IAnalysisApiClient AnalysisApiClient

@inject NavigationManager Navigation

@rendermode InteractiveServer


<EditForm Model="request" OnValidSubmit="HandleValidSubmit" FormName="NewAnalysisForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <h3>Game Metadata</h3>
    <div class="mb-3">
        <label>Game Date</label>
        <InputDate @bind-value="request.GameDate" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Team Name</label>
        <InputText @bind-value="request.TeamName" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Opponent Name</label>
        <InputText @bind-value="request.OpponentName" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Competition</label>
        <InputText @bind-value="request.Competition" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Season</label>
        <InputText @bind-value="request.Season" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Location</label>
        <InputText @bind-value="request.Location" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Level</label>
        <InputSelect @bind-value="request.Level" class="form-select">
            <option value="">Select Level</option>
            <option>EasyBasket</option>
            <option>Youth</option>
            <option>Amateur</option>
            <option>Pro</option>
        </InputSelect>
    </div>
    <div class="mb-3">
        <label>Rules Profile (optional)</label>
        <InputText @bind-value="request.RulesProfile" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Notes</label>
        <InputTextArea @bind-value="request.Notes" class="form-control" rows="3" />
    </div>

    <h3>Game Format</h3>
    <p class="text-muted">The structure of this specific game. Independent of Level - e.g. a Youth game can be played 4x10 or 4x5.</p>
    <div class="mb-3">
        <label>Regulation Periods</label>
        <InputNumber @bind-value="request.GameFormat.RegulationPeriods" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Regulation Period Length (minutes)</label>
        <InputNumber @bind-value="request.GameFormat.RegulationPeriodMinutes" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Overtime Period Length (minutes)</label>
        <InputNumber @bind-value="request.GameFormat.OvertimePeriodMinutes" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Format Name (optional)</label>
        <InputText @bind-value="request.GameFormat.Name" class="form-control" placeholder="e.g. FIBA, NBA, EasyBasket 8x4" />
    </div>

    <h3>Game Timing</h3>
    <div class="mb-3">
        <label>Current Period (1..RegulationPeriods = regulation, beyond that = OT1, OT2, ...)</label>
        <InputNumber @bind-value="request.GameTiming.CurrentPeriod" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Clock Remaining (seconds)</label>
        <InputNumber @bind-value="request.GameTiming.ClockRemainingSeconds" class="form-control" />
    </div>

    <h3>Team Stats</h3>
    <div class="mb-3">
        <label>Points</label>
        <InputNumber @bind-value="request.Team.Points" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Field Goals Made</label>
        <InputNumber @bind-value="request.Team.FieldGoalsMade" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Field Goals Attempted</label>
        <InputNumber @bind-value="request.Team.FieldGoalsAttempted" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Three-Points Made</label>
        <InputNumber @bind-value="request.Team.ThreePointsMade" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Three-Points Attempted</label>
        <InputNumber @bind-value="request.Team.ThreePointsAttempted" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Free Throws Made</label>
        <InputNumber @bind-value="request.Team.FreeThrowsMade" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Free Throws Attempted</label>
        <InputNumber @bind-value="request.Team.FreeThrowsAttempted" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Offensive Rebounds</label>
        <InputNumber @bind-value="request.Team.OffensiveRebounds" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Defensive Rebounds</label>
        <InputNumber @bind-value="request.Team.DefensiveRebounds" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Assists</label>
        <InputNumber @bind-value="request.Team.Assists" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Turnovers</label>
        <InputNumber @bind-value="request.Team.Turnovers" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Steals</label>
        <InputNumber @bind-value="request.Team.Steals" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Blocks</label>
        <InputNumber @bind-value="request.Team.Blocks" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Personal Fouls</label>
        <InputNumber @bind-value="request.Team.PersonalFouls" class="form-control" />
    </div>

    <h3>Opponent Stats</h3>
    <div class="mb-3">
        <label>Points</label>
        <InputNumber @bind-value="request.Opponent.Points" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Field Goals Made</label>
        <InputNumber @bind-value="request.Opponent.FieldGoalsMade" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Field Goals Attempted</label>
        <InputNumber @bind-value="request.Opponent.FieldGoalsAttempted" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Three-Points Made</label>
        <InputNumber @bind-value="request.Opponent.ThreePointsMade" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Three-Points Attempted</label>
        <InputNumber @bind-value="request.Opponent.ThreePointsAttempted" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Free Throws Made</label>
        <InputNumber @bind-value="request.Opponent.FreeThrowsMade" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Free Throws Attempted</label>
        <InputNumber @bind-value="request.Opponent.FreeThrowsAttempted" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Offensive Rebounds</label>
        <InputNumber @bind-value="request.Opponent.OffensiveRebounds" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Defensive Rebounds</label>
        <InputNumber @bind-value="request.Opponent.DefensiveRebounds" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Assists</label>
        <InputNumber @bind-value="request.Opponent.Assists" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Turnovers</label>
        <InputNumber @bind-value="request.Opponent.Turnovers" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Steals</label>
        <InputNumber @bind-value="request.Opponent.Steals" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Blocks</label>
        <InputNumber @bind-value="request.Opponent.Blocks" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Personal Fouls</label>
        <InputNumber @bind-value="request.Opponent.PersonalFouls" class="form-control" />
    </div>

    <button class="btn btn-primary" type="submit" disabled="@isLoading">
        @(isLoading ? "Submitting..." : "Submit Analysis")
    </button>

    <details class="mt-4">
        <summary>Debug: Current request object</summary>
        <pre>@System.Text.Json.JsonSerializer.Serialize(request, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
    </details>
</EditForm>

@if (errorMessage != null)
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}
@if (apiResponse != null && apiResponse.AnalysisId == Guid.Empty)
{
    <div class="alert alert-info mt-3">
        <h5>Suggestions</h5>
        <ul>
            @foreach (var suggestion in AllSuggestionTexts)
            {
                <li>@suggestion</li>
            }
        </ul>
    </div>
}

@code {
    private AnalyzeGameRequestDto request = new AnalyzeGameRequestDto();
    private AnalyzeGameResponseDto? apiResponse;
    private string? errorMessage;
    private bool isLoading = false;

    private IEnumerable<string> AllSuggestionTexts =>
        (apiResponse?.Suggestions.Offense ?? Array.Empty<SuggestionItemDto>())
            .Concat(apiResponse?.Suggestions.Defense ?? Array.Empty<SuggestionItemDto>())
            .Concat(apiResponse?.Suggestions.Other ?? Array.Empty<SuggestionItemDto>())
            .Select(s => s.Suggestion ?? string.Empty);

    private async Task HandleValidSubmit()
    {
        isLoading = true;
        errorMessage = null;
        apiResponse = null;
        try
        {
            var response = await AnalysisApiClient.AnalyzeGameAsync(request);
            if (response.AnalysisId != Guid.Empty)
            {
                Navigation.NavigateTo($"/admin/analyses/{response.AnalysisId}");
            }
            else
            {
                apiResponse = response;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
